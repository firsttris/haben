# Firmenportal (#504): als .env neben compose.yml. Siehe Installation > Firmenportal.

# Öffentliche Adresse des Firmenportals; beim Anmeldedienst als Redirect-URI <PORTAL_URL>/callback eintragen
PORTAL_URL=https://firmenportal.example.de
# Signiert die Cookies der Anmeldung: openssl rand -base64 32
PORTAL_SECRET=
# Port auf 127.0.0.1 für den Reverse Proxy (compose.yml)
# PORTAL_PORT=3010

# Die Firmen: je Firma Name|https://adresse|Inhaber-Gruppe, getrennt durch ;. Die Gruppe ist OIDC_GROUP_INHABER der
# Instanz. Wer in der Gruppe ist, sieht die Firma; die Gruppen der Steuerberatung zählen nicht. Dahinter wahlweise
# |Farbe|Logo: Farbe als #RRGGBB, Logo als Dateiname in logos/ neben compose.yml (haben status --json und
# haben kennzeichen in der Instanz geben beides aus; Installation > Firmenportal).
PORTAL_FIRMEN='Studio Nord|https://nord.example.de|haben-nord-inhaber|#1D4ED8|nord.png;Werkstatt|https://werkstatt.example.de|haben-werkstatt-inhaber'

# Eigener Client beim Anmeldedienst, wie in den Instanzen (docs/installation-sso.md)
OIDC_ISSUER=https://auth.example.de
OIDC_CLIENT_ID=haben-firmenportal
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Authelia
# OIDC_SCOPES=openid profile email groups
# OIDC_GROUPS_CLAIM=groups
