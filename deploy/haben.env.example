# Öffentliche Adresse; muss zur Domain im Caddyfile passen (Passkeys hängen daran)
BETTER_AUTH_URL=https://haben.example.de
# ERiC beim Start von download.elster.de laden (ja = Zustimmung zu den Nutzungsbedingungen von ERiC);
# alternativ unter Einstellungen › ERiC per Knopf
# ERIC_AUTO_INSTALL=ja
# Oder ERiC von Hand: erst setzen, wenn /opt/eric eingerichtet und das Volume in haben-app.container einkommentiert ist
# ERIC_HOME=/opt/eric
# Nach erfolgreicher Testübermittlung beantragen und hier eintragen
ELSTER_HERSTELLER_ID=
# Automatischer Kontoabruf über Enable Banking: Application ID eintragen und das Secret in haben-app.container einkommentieren
# ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_FILE=/run/secrets/enablebanking.pem
