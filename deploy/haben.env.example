# Öffentliche Adresse; muss zur Domain im Caddyfile passen (Passkeys hängen daran)
BETTER_AUTH_URL=https://haben.example.de
# ERiC beim Start von download.elster.de laden (ja = Zustimmung zu den Nutzungsbedingungen von ERiC);
# alternativ unter Einstellungen › ERiC per Knopf
# ERIC_AUTO_INSTALL=ja
# Erwartete SHA-256 des ERiC-Pakets; stimmt sie nicht, wird es nicht installiert
# ERIC_SHA256=
# Oder ERiC von Hand: erst setzen, wenn /opt/eric eingerichtet und das Volume in haben-app.container einkommentiert ist
# ERIC_HOME=/opt/eric
# Nur auf arm64: ERiC-Worker emuliert als x86_64 starten; erst setzen, wenn deploy/eric-x86_64/einrichten.sh gelaufen und
# das Volume /opt/haben-x86_64 in haben-app.container einkommentiert ist
# ERIC_WORKER_COMMAND=/opt/haben-x86_64/worker.sh
# Nach erfolgreicher Testübermittlung beantragen und hier eintragen
ELSTER_HERSTELLER_ID=
# KI-Auslesung von Belegen mit einem selbst betriebenen Modell (OpenAI-kompatibel, z. B. Ollama auf dem Host);
# ein Schlüssel dafür gehört als Secret in haben-app.container
# EXTRACTION_BASE_URL=http://host.containers.internal:11434/v1
# EXTRACTION_MODEL=qwen2.5vl:7b
# Automatischer Kontoabruf über Enable Banking: Application ID eintragen und das Secret in haben-app.container einkommentieren
# ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_FILE=/run/secrets/enablebanking.pem

# Betriebsart: false (Vorgabe) ausschließlich lokale Anmeldung mit Passwort und Passkeys,
# true ausschließlich SSO (z. B. Authelia), Rollen aus den Gruppen. Einen gemischten Modus gibt es nicht.
# OIDC_ONLY=false
# Nur mit OIDC_ONLY=true gelesen und dann Pflicht (außer Anzeigename und Claim):
# OIDC_ISSUER=https://auth.example.de
# OIDC_CLIENT_ID=haben
# OIDC_CLIENT_SECRET=<urspruengliches-clientsecret-kein-hash>
# OIDC_DISPLAY_NAME=Authelia
# OIDC_GROUPS_CLAIM=groups
# OIDC_GROUP_INHABER=haben-inhaber
# OIDC_GROUP_STEUERBERATUNG=haben-steuerberatung
