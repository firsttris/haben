# Domain, unter der Haben läuft (ohne https://). Muss auf den Server zeigen, Ports 80 und 443 offen.
# Passkeys hängen an dieser Domain; später nicht mehr ändern.
DOMAIN=haben.example.de

# Datenbank-Passwort, nur Buchstaben und Ziffern:  openssl rand -hex 24
DB_PASSWORD=

# Signiert die Sitzungen:  openssl rand -base64 32
AUTH_SECRET=

# Verschlüsselt ELSTER-Zertifikat und Lexoffice-Schlüssel:  openssl rand -base64 32
# Zusätzlich an einem zweiten Ort sichern; ohne ihn sind beide nach einer Wiederherstellung verloren.
ENCRYPTION_KEY=

# Verschlüsselt das Backup (restic):  openssl rand -base64 32
# Wie ENCRYPTION_KEY an einem zweiten Ort sichern (Passwortmanager); ohne beide ist das Backup wertlos.
RESTIC_PASSWORD=
# Optional: Backup auf einem zweiten System statt im Volume backups, z. B. sftp:backup@example.de:/srv/restic/haben,
# s3:s3.eu-central-1.amazonaws.com/bucket/haben (dazu AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) oder rest:https://…
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Uhrzeit des täglichen Backups (Standard 03:15)
BACKUP_TIME=

# Optional: ERiC beim Start von download.elster.de laden (ja = Zustimmung zu den Nutzungsbedingungen von ERiC).
# Alternativ unter Einstellungen › ERiC per Knopf.
ERIC_AUTO_INSTALL=
# Oder ERiC von Hand einbinden (Volume in compose.yml einkommentieren)
ERIC_HOME=
# Optional: eigene Hersteller-ID, erst nach erfolgreicher Testübermittlung
ELSTER_HERSTELLER_ID=
# Optional: KI-Auslesung von Belegen
ANTHROPIC_API_KEY=
# Optional: automatischer Kontoabruf über Enable Banking (Schlüsseldatei in compose.yml einkommentieren)
ENABLE_BANKING_APP_ID=
