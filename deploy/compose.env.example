# Domain, unter der Haben läuft (ohne https://). Muss auf den Server zeigen, Ports 80 und 443 offen.
# Passkeys hängen an dieser Domain; später nicht mehr ändern.
DOMAIN=haben.example.de

# Datenbank-Passwort, nur Buchstaben und Ziffern:  openssl rand -hex 24
DB_PASSWORD=

# Signiert die Sitzungen:  openssl rand -base64 32
AUTH_SECRET=

# Verschlüsselt ELSTER-Zertifikat und Lexoffice-Schlüssel:  openssl rand -base64 32
# Zusätzlich an einem zweiten Ort sichern; ohne ihn sind beide nach einer Wiederherstellung verloren.
ENCRYPTION_KEY=

# Verschlüsselt das Backup (restic):  openssl rand -base64 32
# Wie ENCRYPTION_KEY an einem zweiten Ort sichern (Passwortmanager); ohne beide ist das Backup wertlos.
RESTIC_PASSWORD=
# Optional: Backup auf einem zweiten System statt im Volume backups, z. B. sftp:backup@example.de:/srv/restic/haben,
# s3:s3.eu-central-1.amazonaws.com/bucket/haben (dazu AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) oder rest:https://…
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: Uhrzeit des täglichen Backups (Standard 03:15)
BACKUP_TIME=
# Optional: Test-Restore nach dem Backup alle so viele Tage (Standard 7, 0 schaltet ihn ab)
RESTORE_CHECK_DAYS=

# Optional: ERiC beim Start von download.elster.de laden (ja = Zustimmung zu den Nutzungsbedingungen von ERiC).
# Alternativ unter Einstellungen › ERiC per Knopf.
ERIC_AUTO_INSTALL=
# Optional: erwartete SHA-256 des ERiC-Pakets; stimmt sie nicht, wird es nicht installiert
ERIC_SHA256=
# Oder ERiC von Hand einbinden (Volume in compose.yml einkommentieren)
ERIC_HOME=
# Optional, nur auf arm64: ERiC-Worker emuliert als x86_64 starten (deploy/eric-x86_64/einrichten.sh, Volume in compose.yml)
ERIC_WORKER_COMMAND=
# Optional: eigene Hersteller-ID, erst nach erfolgreicher Testübermittlung
ELSTER_HERSTELLER_ID=
# Optional: KI-Auslesung von Belegen mit Claude (Anthropic-API)
ANTHROPIC_API_KEY=
# Oder über eine OpenAI-kompatible Schnittstelle: selbst betrieben (Ollama, LM Studio, vLLM) oder in der Cloud
# (OpenRouter, OpenAI, …); ist EXTRACTION_BASE_URL gesetzt, gilt nur dieser Dienst. Beispiel Ollama auf dem Server selbst:
# EXTRACTION_BASE_URL=http://host.docker.internal:11434/v1
# EXTRACTION_MODEL=qwen2.5vl:7b
# Beispiel OpenRouter (Schlüssel in EXTRACTION_API_KEY):
# EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
# EXTRACTION_MODEL=qwen/qwen2.5-vl-72b-instruct
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
# Nur falls der Dienst einen Schlüssel verlangt
EXTRACTION_API_KEY=
# Optional: automatischer Kontoabruf über Enable Banking (Schlüsseldatei in compose.yml einkommentieren)
ENABLE_BANKING_APP_ID=

# Betriebsart: false (Vorgabe) ausschließlich lokale Anmeldung mit Passwort und Passkeys,
# true ausschließlich SSO (z. B. Authelia), Rollen aus den Gruppen. Einen gemischten Modus gibt es nicht.
# OIDC_ONLY=false
# Nur mit OIDC_ONLY=true gelesen und dann Pflicht (außer Anzeigename und Claim), siehe docs/installation.md:
# OIDC_ISSUER=https://auth.example.de
# OIDC_CLIENT_ID=haben
# OIDC_CLIENT_SECRET=<urspruengliches-clientsecret-kein-hash>
# OIDC_DISPLAY_NAME=Authelia
# OIDC_GROUPS_CLAIM=groups
# OIDC_GROUP_INHABER=haben-inhaber
# OIDC_GROUP_STEUERBERATUNG=haben-steuerberatung
