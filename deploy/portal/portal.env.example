# Haben-Portal (#504): als .env neben compose.yml. Siehe Installation > Portal.

# Öffentliche Adresse des Portals; beim Anmeldedienst als Redirect-URI <PORTAL_URL>/callback eintragen
PORTAL_URL=https://portal.example.de
# Signiert die Cookies der Anmeldung: openssl rand -base64 32
PORTAL_SECRET=

# Die Firmen: je Firma Name|https://adresse|Inhaber-Gruppe, getrennt durch ;. Die Gruppe ist OIDC_GROUP_INHABER der
# Instanz. Wer in der Gruppe ist, sieht die Firma; die Gruppen der Steuerberatung zählen nicht.
PORTAL_FIRMEN='Studio Nord|https://nord.example.de|haben-nord-inhaber;Werkstatt|https://werkstatt.example.de|haben-werkstatt-inhaber'

# Eigener Client beim Anmeldedienst, wie in den Instanzen (docs/installation-sso.md)
OIDC_ISSUER=https://auth.example.de
OIDC_CLIENT_ID=haben-portal
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Authelia
# OIDC_SCOPES=openid profile email groups
# OIDC_GROUPS_CLAIM=groups
