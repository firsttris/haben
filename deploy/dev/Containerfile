# Haben – Container für die Entwicklung, gestartet über compose.yml im Hauptordner.
# Die Quellen kommen per Bind-Mount aus dem Projektordner, node_modules liegt in Volumes: So hat der Container
# seine eigenen nativen Pakete (Typst, esbuild) für Linux, auch wenn der Rechner macOS ist.
FROM docker.io/oven/bun:1.4.4-slim
# Der Benutzer im Container bekommt die IDs des Entwicklers, damit ihm die Dateien gehören,
# die der Dev-Server im Projektordner anlegt (.tanstack, .nitro)
ARG UID=1000
ARG GID=1000
# poppler-utils: pdftoppm (PDFs als Seitenbilder für einen selbst betriebenen KI-Dienst) und pdftotext
# (Textebene, eigene Rechnung erkennen). zip und unzip: nur für den Test des Pakets „Haben für Mein ELSTER“
# (scripts/elster-helfer), deshalb nur hier und nicht im Image für den Betrieb.
RUN apt-get update \
 && apt-get install -y --no-install-recommends poppler-utils zip unzip \
 && rm -rf /var/lib/apt/lists/*
# Die Ziele der Volumes vorher anlegen: Ein neues Volume übernimmt Besitzer und Rechte des Ordners im Image
RUN groupmod -o -g "$GID" bun && usermod -o -u "$UID" -g "$GID" bun \
 && mkdir -p /app/node_modules /app/apps/web/node_modules /app/apps/elster-helfer/node_modules \
      /app/packages/core/node_modules /app/packages/einvoice/node_modules \
      /app/packages/elster/node_modules /app/packages/gobd-kern/node_modules /app/packages/import/node_modules \
      /var/lib/haben /home/bun/.cache \
 && chown -R bun:bun /app /var/lib/haben /home/bun
COPY --chmod=755 start.sh /usr/local/bin/haben-dev
# Kein USER bun: start.sh beginnt als root, richtet die Besitzer der Volumes und wechselt dann zu bun
ENV BUN_INSTALL_CACHE_DIR=/home/bun/.cache/bun
WORKDIR /app
ENTRYPOINT []
CMD ["haben-dev"]
