[Unit]
Description=Haben – App
Requires=haben-db.service
After=haben-db.service

[Container]
ContainerName=haben-app
# Fertiges Image von Docker Hub (amd64 und arm64); selbst gebaut: Image=localhost/haben:latest
Image=docker.io/tristanteu/haben:latest
# `podman auto-update` zieht neue Images und startet den Dienst neu
AutoUpdate=registry
Network=haben.network
# ERiC (nur Linux x86_64): nach /opt/eric entpacken, Zeile einkommentieren, ERIC_HOME in haben.env setzen
# Volume=/opt/eric:/opt/eric:ro
# Belegdateien (GoBD: 10 Jahre aufbewahren, gehört ins Backup)
Volume=haben-belege.volume:/var/lib/haben/belege
EnvironmentFile=%h/.config/haben/haben.env
Secret=haben-database-url,type=env,target=DATABASE_URL
Secret=haben-auth-secret,type=env,target=BETTER_AUTH_SECRET
Secret=haben-encryption-key,type=env,target=HABEN_ENCRYPTION_KEY
# Optional: KI-Auslesung von Belegen
# Secret=haben-anthropic-key,type=env,target=ANTHROPIC_API_KEY

[Service]
Restart=always

[Install]
WantedBy=default.target
