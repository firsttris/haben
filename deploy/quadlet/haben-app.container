[Unit]
Description=Haben – App
Requires=haben-db.service
After=haben-db.service

[Container]
ContainerName=haben-app
# Fertiges Image von Docker Hub (amd64 und arm64); selbst gebaut: Image=localhost/haben:latest
Image=docker.io/tristanteu/haben:latest
# `podman auto-update` zieht neue Images und startet den Dienst neu
AutoUpdate=registry
Network=haben.network
# Gehärtet: Dateisystem schreibgeschützt bis auf die Volumes unten (/tmp legt Podman bei ReadOnly selbst als tmpfs an),
# keine Capabilities, keine neuen Rechte
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# Alternativ ERiC von Hand (nur Linux x86_64): nach /opt/eric entpacken, Zeile einkommentieren, ERIC_HOME in haben.env setzen
# Volume=/opt/eric:/opt/eric:ro
# ELSTER auf arm64: x86_64-Laufzeit aus deploy/eric-x86_64/einrichten.sh, Zeile einkommentieren, ERIC_WORKER_COMMAND in haben.env
# Volume=/opt/haben-x86_64:/opt/haben-x86_64:ro
# Belegdateien: gehören ins Backup; Aufbewahrung: Bücher und Aufzeichnungen 10 Jahre, Buchungsbelege 8 Jahre (§ 147 Abs. 3 AO)
Volume=haben-belege.volume:/var/lib/haben/belege
# Protokolle von ERiC (eric.log), zur Fehlersuche bei der Übermittlung
Volume=haben-eric-log.volume:/var/lib/haben/eric-log
# ERiC, von Haben heruntergeladen (Einstellungen › ELSTER › ERiC oder ERIC_AUTO_INSTALL=ja in haben.env)
Volume=haben-eric.volume:/var/lib/haben/eric
# OIDC_SCOPES in haben.env legt bei Bedarf die angefragten Scopes fest.
EnvironmentFile=%h/.config/haben/haben.env
Secret=haben-database-url,type=env,target=DATABASE_URL
# Bei getrennten Datenbankrollen einkommentieren (neue Installationen): Eigentümerzugang nur für Migrationen.
# Secret=haben-migration-database-url,type=env,target=MIGRATION_DATABASE_URL
Secret=haben-auth-secret,type=env,target=BETTER_AUTH_SECRET
Secret=haben-encryption-key,type=env,target=HABEN_ENCRYPTION_KEY
# Optional: SSO-Modus (OIDC_ONLY=true); übrige OIDC-Werte und Gruppen stehen in haben.env
# Secret=haben-oidc-client-secret,type=env,target=OIDC_CLIENT_SECRET
# Optional: KI-Auslesung von Belegen
# Secret=haben-anthropic-key,type=env,target=ANTHROPIC_API_KEY
# Optional: Schlüssel eines selbst betriebenen KI-Dienstes, falls er einen verlangt
# Secret=haben-extraction-key,type=env,target=EXTRACTION_API_KEY
# Automatischer Kontoabruf: privater Schlüssel der Enable-Banking-Anwendung als Datei
# Secret=haben-enablebanking-key,type=mount,target=enablebanking.pem,uid=1000,mode=0400

[Service]
Restart=always

[Install]
WantedBy=default.target
