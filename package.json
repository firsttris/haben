{
  "name": "haben",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @haben/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags",
    "lint": "biome lint --error-on-warnings && node scripts/modulgrenzen/pruefen.ts",
    "test": "vitest run",
    "db:generate": "pnpm --filter @haben/web db:generate",
    "db:migrate": "pnpm --filter @haben/web db:migrate",
    "e2e": "pnpm --filter @haben/web e2e",
    "docs:screenshots": "DOKU_SCREENSHOTS=1 LANG=de_DE.UTF-8 LANGUAGE=de pnpm e2e && pnpm docs:social-preview",
    "docs:social-preview": "node scripts/social-preview/render.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "oxc-parser": "^0.156.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
