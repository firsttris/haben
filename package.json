{
  "name": "haben",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --workspaces typecheck",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "postversion": "git push --follow-tags",
    "lint": "bun --bun biome check --error-on-warnings && bun scripts/modulgrenzen/pruefen.ts && bun scripts/seitenabdeckung/pruefen.ts && bun scripts/dateigroesse/pruefen.ts",
    "format": "bun --bun biome format --write",
    "test": "bun --bun vitest run",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "e2e": "bun run --cwd apps/web e2e",
    "docs:screenshots": "DOKU_SCREENSHOTS=1 LANG=de_DE.UTF-8 LANGUAGE=de bun run e2e && bun run docs:social-preview && bun run docs:hero && bun run docs:hell-dunkel",
    "docs:social-preview": "bun scripts/social-preview/render.mjs",
    "docs:hero": "bun scripts/hero/render.mjs",
    "docs:hell-dunkel": "bun scripts/hell-dunkel/render.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tanstack/redact": "0.3.1",
    "oxc-parser": "^0.156.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "trustedDependencies": [
    "esbuild",
    "koffi"
  ]
}
