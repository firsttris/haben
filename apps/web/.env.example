DATABASE_URL=postgres://haben:haben@localhost:5432/haben
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32 (verschlüsselt die ELSTER-Zertifikatsdatei; nicht verlieren)
HABEN_ENCRYPTION_KEY=
# Entpacktes ERiC-Paket; leer = Prüfen und Senden werden simuliert
ERIC_HOME=
ERIC_LOG_DIR=
# Hersteller-ID für den Echtbetrieb; ohne sie nur Testübermittlung
ELSTER_HERSTELLER_ID=
# Ablage der Belegdateien
DOCUMENTS_DIR=data/belege
# Optional: KI-Auslesung von Belegen (PDF, Fotos); ohne Schlüssel nur E-Rechnungen automatisch
ANTHROPIC_API_KEY=
# Optional: andere Adresse der Lexware-Office-API (Standard https://api.lexware.io/v1)
LEXOFFICE_API_URL=
# Optional: automatischer Kontoabruf über Enable Banking (Application ID und Pfad zum privaten Schlüssel)
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_FILE=
