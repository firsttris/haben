{
  "manifest_version": 3,
  "name": "Haben für Mein ELSTER",
  "version": "0.1.0",
  "description": "Trägt Werte aus Haben in die Formulare von Mein ELSTER ein. Prüfen und absenden machst du selbst.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Haben für Mein ELSTER",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.elster.de/eportal/interpreter/eingabe/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
